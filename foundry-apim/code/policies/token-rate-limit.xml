<!--
  AI Gateway: Token Rate Limiting Policy
  =======================================
  Limits the total number of LLM tokens (prompt + completion) that can be
  consumed per subscription key within a rolling time window.

  How it works:
  1. The policy inspects the 'usage' object in the AI Foundry / OpenAI response
     body (present on all chat completions and completions responses).
  2. It accumulates total_tokens against a counter keyed by the caller's
     APIM subscription key.
  3. When the counter exceeds the configured limit within the renewal window,
     subsequent requests receive HTTP 429 Too Many Requests.
  4. The counter resets when the renewal period expires.

  Variables (injected by Terraform templatefile):
  - tokens_per_minute : integer  — max total tokens per renewal window
  - renewal_period    : integer  — window duration in seconds (default 60 = 1 min)

  Reference:
  https://learn.microsoft.com/en-us/azure/api-management/azure-openai-token-limit-policy
-->
<policies>
  <inbound>
    <base />
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
    <!-- Extract token usage from the AI Foundry / OpenAI response -->
    <azure-openai-token-limit
      counter-key="@(context.Subscription.Id)"
      tokens-per-minute="${tokens_per_minute}"
      estimate-prompt-tokens="false"
      remaining-tokens-header-name="x-ratelimit-remaining-tokens"
      remaining-tokens-variable-name="remainingTokens">
      <renew-after-seconds>${renewal_period}</renew-after-seconds>
    </azure-openai-token-limit>
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
